// Cloudflare Workers config for the CRC The Peridona microsite.
//
// The site is a static Next.js export (`output: "export"` in next.config.ts).
// worker.js handles the /api/revalidate endpoint for Growth Studio,
// and routes all other traffic to static assets in ./out.
{
  "name": "crcperidona",
  "compatibility_date": "2026-11-01",
  "main": "worker.js",
  "assets": {
    "directory": "./out",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
   "vars": {
    "CMS_REVALIDATE_SECRET": "18cddfd1095fe44e19d07a4c5f9f4d69f7baaaa6b5975f1b3384e5b6399691d4"
  },
  "previews": {},
  "observability": {
    "enabled": true
  }
}
